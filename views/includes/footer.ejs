<style>
    footer {
    margin-top: auto;
}
.f-info {
    min-height: 6.5rem;
    padding: 1.4rem 5%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background: #fafafa;
    border-top: 1px solid #e8e8e8;

    box-sizing: border-box;
}

/* 
   SOCIAL ICONS
                 */

.f-info-socials {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.f-info-socials a {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #fff;
    border: 1px solid #e5e5e5;

    font-size: 1.05rem;
    text-decoration: none;

    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        background-color 0.25s ease,
        color 0.25s ease;
}


/* Facebook */

.f-info-socials a:nth-child(1) {
    color: #4267b2;
}

.f-info-socials a:nth-child(1):hover {
    background: #f0f4ff;
    border-color: #d5def5;
    color: #1877f2;

    transform: translateY(-4px);

    box-shadow: 0 8px 20px rgba(24, 119, 242, 0.14);
}


/* Instagram */

.f-info-socials a:nth-child(2) {
    color: #c13584;
}

.f-info-socials a:nth-child(2):hover {
    background: #fff1f7;
    border-color: #f4d5e5;
    color: #e1306c;

    transform: translateY(-4px);

    box-shadow: 0 8px 20px rgba(225, 48, 108, 0.14);
}


/* LinkedIn */

.f-info-socials a:nth-child(3) {
    color: #2867b2;
}

.f-info-socials a:nth-child(3):hover {
    background: #eef7ff;
    border-color: #d1e6f7;
    color: #0a66c2;

    transform: translateY(-4px);

    box-shadow: 0 8px 20px rgba(10, 102, 194, 0.14);
}
.f-info-brand {
    color: #444;

    font-size: 0.9rem;
    font-weight: 500;

    letter-spacing: 0.15px;
}



.f-info-links {
    display: flex;
    align-items: center;
    gap: 1.8rem;
}

.f-info-links a {
    position: relative;

    color: #444;

    font-size: 0.88rem;
    font-weight: 500;

    text-decoration: none;

    transition: color 0.2s ease;
}

.f-info-links a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -5px;

    width: 0;
    height: 1.5px;

    background: #ff385c;

    transition: width 0.25s ease;
}

.f-info-links a:hover {
    color: #ff385c;
}

.f-info-links a:hover::after {
    width: 100%;
}




@media (max-width: 700px) {

    .f-info {
        flex-direction: column;
        gap: 1rem;

        padding: 1.8rem 1rem;
    }

    .f-info-socials {
        order: 1;
    }

    .f-info-brand {
        order: 2;
        text-align: center;
    }

    .f-info-links {
        order: 3;
        gap: 1.5rem;
    }
}
</style>
<footer>
   <div class="f-info">
    <div class="f-info-socials">
        <a href="https://www.facebook.com"><i class="fa-brands fa-square-facebook"></i></a>
        <a href="https://www.instagram.com"><i class="fa-brands fa-square-instagram"></i></a>
        <a href="https://in.linkedin.com"><i class="fa-brands fa-square-linkedin"></i></a>
    </div>
    <div class="f-info-brand"> &copy; WanderLust Private Limited</div>
    <div class="f-info-links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
    </div>
   </div> 
</footer>